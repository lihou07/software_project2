
#include <Servo.h>

// Arduino pin assignment
#define PIN_IR    A0
#define PIN_LED   9
#define PIN_SERVO 10

#define _DUTY_MIN 1000
#define _DUTY_NEU 1500
#define _DUTY_MAX 2000

#define _DIST_MIN 100.0
#define _DIST_MAX 250.0

#define EMA_ALPHA 0.4
#define LOOP_INTERVAL 20

#define FILTER_SIZE 5

Servo myservo;
unsigned long last_loop_time = 0;

float dist_prev = 175.0;
float dist_ema = 175.0;

float dist_buffer[FILTER_SIZE];
int buffer_index = 0;
int buffer_count = 0;

// Median Filter
float medianFilter(float value)
{
  dist_buffer[buffer_index] = value;
  buffer_index = (buffer_index + 1) % FILTER_SIZE;

  if (buffer_count < FILTER_SIZE)
    buffer_count++;

  float sorted[FILTER_SIZE];

  for (int i = 0; i < buffer_count; i++)
    sorted[i] = dist_buffer[i];

  for (int i = 0; i < buffer_count - 1; i++) {
    for (int j = i + 1; j < buffer_count; j++) {
      if (sorted[i] > sorted[j]) {
        float temp = sorted[i];
        sorted[i] = sorted[j];
        sorted[j] = temp;
      }
    }
  }

  if (buffer_count % 2 == 1)
    return sorted[buffer_count / 2];

  return (sorted[buffer_count / 2 - 1]
        + sorted[buffer_count / 2]) / 2.0;
}

void setup()
{
  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW);

  myservo.attach(PIN_SERVO);
  myservo.writeMicroseconds(_DUTY_NEU);

  Serial.begin(1000000);
}

void loop()
{
  unsigned long time_curr = millis();

  if (time_curr - last_loop_time < LOOP_INTERVAL)
    return;

  last_loop_time += LOOP_INTERVAL;

  float a_value = analogRead(PIN_IR);
  float dist_raw;
  float dist_filtered;
  int duty;

  // IR distance calculation
  if (a_value > 9.0) {
    dist_raw = ((6762.0 / (a_value - 9.0))
               - 4.0) * 10.0 - 60.0;
  }
  else {
    dist_raw = -1.0;
  }

  // Range Filter
  bool valid = (dist_raw >= _DIST_MIN &&
                dist_raw <= _DIST_MAX);

  if (valid) {
    dist_filtered = medianFilter(dist_raw);
    dist_prev = dist_filtered;
    digitalWrite(PIN_LED, HIGH);
  }
  else {
    dist_filtered = dist_prev;
    digitalWrite(PIN_LED, LOW);
  }

  // EMA Filter
  dist_ema = EMA_ALPHA * dist_prev
           + (1.0 - EMA_ALPHA) * dist_ema;

  // Linear mapping without map()
  duty = _DUTY_MIN
       + (dist_ema - _DIST_MIN)
       * (_DUTY_MAX - _DUTY_MIN)
       / (_DIST_MAX - _DIST_MIN);

  duty = constrain(duty, _DUTY_MIN, _DUTY_MAX);

  myservo.writeMicroseconds(duty);

  // Serial Plotter output
  // Show actual measured distance
  Serial.print("_DUTY_MIN:");
  Serial.print(_DUTY_MIN);

  Serial.print(",_DIST_MIN:");
  Serial.print(_DIST_MIN);

  Serial.print(",IR:");
  Serial.print(a_value);

  Serial.print(",dist_raw:");
  Serial.print(dist_raw);

  Serial.print(",ema:");
  Serial.print(dist_ema);

  Serial.print(",servo:");
  Serial.print(duty);

  Serial.print(",_DIST_MAX:");
  Serial.print(_DIST_MAX);

  Serial.print(",_DUTY_MAX:");
  Serial.print(_DUTY_MAX);

  Serial.println("");
}
